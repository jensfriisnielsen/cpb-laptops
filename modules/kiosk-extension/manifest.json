{
  "manifest_version": 3,
  "name": "Koderup kiosk no context menu",
  "version": "1.1",
  "host_permissions": ["http://127.0.0.1:4173/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
